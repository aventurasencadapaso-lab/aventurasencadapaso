<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Aventuras en Cada Paso" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Todas las rutas – Aventuras en Cada Paso</name>
    <desc>236 rutas outdoor en las 9 islas de Canarias</desc>
    <author><name>Aventuras en Cada Paso</name></author>
  </metadata>
  <wpt lat="28.2743" lon="-16.6426">
    <name>Ascensión al Teide – Montaña Blanca (Sendero 7)</name>
    <desc>La ruta más icónica de España. Desde Montaña Blanca (2.300 m) hasta La Rambleta (3.555 m). Requiere permiso para subir los últimos 200 m hasta la cima. | Tenerife | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2253" lon="-16.6139">
    <name>Roques de García – Sendero 3 Teide</name>
    <desc>Circular por las formaciones volcánicas más espectaculares del Teide: Roque Cinchado, El Torrotito y el Llano de Ucanca. Apta para familias. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2636" lon="-16.6819">
    <name>Pico Viejo – Sendero 13</name>
    <desc>Ascenso al volcán hermano del Teide con vistas únicas al cráter de Pico Viejo. Pinar canario milenario y panorámicas de los conos volcánicos. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5022" lon="-16.7044">
    <name>Ruta 0-4-0 Teide</name>
    <desc>Del nivel del mar en Playa del Socorro hasta la cima del Teide y vuelta al mar. La ruta más extrema de Canarias: más de 3.700 m de desnivel. | Tenerife | Senderismo | Extrema</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1582" lon="-16.6419">
    <name>Vilaflor – Paisaje Lunar (PR-TF 72)</name>
    <desc>Circular desde Vilaflor por pinares hasta el Paisaje Lunar, formaciones de piedra pómez erosionada que parecen de otro planeta. Impresionante. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2369" lon="-16.4569">
    <name>Volcán de Fasnia – Siete Fuentes</name>
    <desc>Sendero 20 del Teide por los conos volcánicos de la erupción de 1705. Negro intenso de la lava con tajinastes rojos y azules en primavera. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3469" lon="-16.7944">
    <name>San José de los Llanos – Chinyero</name>
    <desc>Ruta por las coladas del último volcán en erupción de Tenerife (1909). Lava negra entre pinos centenarios. Ideal para familias y niños. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5667" lon="-16.1833">
    <name>Anaga – Afur a Taganana (Circular)</name>
    <desc>Una de las mejores rutas de Canarias. Laurisilva salvaje, barrancos profundos y la playa virgen del Tamadite. Joya del Macizo de Anaga. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.572" lon="-16.1956">
    <name>Anaga – Roque Taborno</name>
    <desc>Sendero corto pero espectacular hasta el Roque Taborno. No apto para vértigo. Vistas únicas al Atlántico Norte y la costa salvaje de Anaga. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5642" lon="-16.2817">
    <name>Cruz del Carmen – Punta del Hidalgo</name>
    <desc>Ruta lineal desde el corazón de Anaga hasta la costa. Pasa por Chinamada, pueblo de casas-cueva habitadas y acantilados de Punta del Hidalgo. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5511" lon="-16.2378">
    <name>Bosque de los Enigmas – Anaga</name>
    <desc>Circular sencilla desde el Mirador de Zapata por laurisilva bien señalizada. Perfecta para familias. Llevar ropa de abrigo por la humedad. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5594" lon="-16.1633">
    <name>Taganana – Playa del Tamadite</name>
    <desc>Ruta lineal hasta la playa del Tamadite, arena negra volcánica solo accesible a pie. La marea baja revela la playa en todo su esplendor. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.578" lon="-16.162">
    <name>Sendero de El Pijaral – Anaga</name>
    <desc>La laurisilva más protegida de Tenerife. Reserva Natural Integral de El Pijaral. Requiere permiso del Cabildo. Experiencia única e irrepetible. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5811" lon="-16.1619">
    <name>Benijo – Cruz del Draguillo (PR-TF 6.3)</name>
    <desc>Precioso recorrido con vistas a la costa de Anaga y al caserío del Draguillo. Iniciar pronto por el aparcamiento limitado. Arquitectura rural única. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3483" lon="-16.8469">
    <name>Barranco de Masca</name>
    <desc>Descenso espectacular por el barranco más famoso de Tenerife hasta la playa. Requiere reserva previa en el Cabildo y regreso en barco. | Tenerife | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3619" lon="-16.8533">
    <name>Teno – Monte del Agua – Risco Verde</name>
    <desc>Laurisilva del Monte del Agua hasta los miradores únicos del Risco Verde. Vistas a Masca, Santiago del Teide y el Teide al fondo. | Tenerife | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3467" lon="-16.8028">
    <name>Erjos – Circular Parque Rural de Teno</name>
    <desc>Agradable circular por el Parque Rural de Teno con dos paisajes distintos: bosque húmedo y zona más árida. Cruz de Gala con vistas panorámicas. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3658" lon="-16.825">
    <name>Valle de El Palmar – Teno Alto</name>
    <desc>Circular por el Valle de El Palmar hasta Teno Alto por bosque de brezos y laurisilva única en altura. Vistas excepcionales al norte de la isla. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1064" lon="-16.7261">
    <name>Barranco del Infierno – Adeje</name>
    <desc>Reserva Natural Especial. Sendero hasta cascada de 80 m con cuevas aborígenes y grabados rupestres. Requiere reserva previa obligatoria. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1342" lon="-16.6831">
    <name>Roque del Conde – Arona</name>
    <desc>Ascenso al Roque del Conde (1.001 m) con vistas de la Caldera del Rey y en días despejados La Palma, La Gomera y El Hierro. | Tenerife | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3139" lon="-16.3994">
    <name>Malpaís de Güímar</name>
    <desc>Reserva Natural Especial con paisaje desértico volcánico rojizo. Tubos y cuevas volcánicas, miradores y flora endémica. Muy fotografiable. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0453" lon="-16.5344">
    <name>Montaña Roja – El Médano</name>
    <desc>Circular corta al volcán de 171 m que separa las mejores playas naturales del sur. Referente en el horizonte y vistas a Gran Canaria. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3856" lon="-16.6189">
    <name>Rambla de Castro – Costa Norte</name>
    <desc>Espacio protegido con bancales agrícolas históricos sobre los acantilados del norte. Playas de arena negra y vistas únicas al Atlántico. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3912" lon="-16.5264">
    <name>Los Órganos – La Orotava</name>
    <desc>Espectacular circular por la Caldera y Los Órganos, columnas basálticas únicas. Gran variedad de paisajes, flora y desnivel considerable. | Tenerife | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5578" lon="-16.2778">
    <name>Sendero de los Sentidos – Anaga</name>
    <desc>Triple ruta desde Cruz del Carmen con experiencia sensorial única entre laurisilva. Une Anaga con La Laguna. Muy didáctica y bien señalizada. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3728" lon="-16.77">
    <name>Circular Garachico – PR-TF 43</name>
    <desc>Circular bien señalizada desde el pueblo histórico de Garachico. Restos de lava volcánica, costa norte y pinar. Apto para todos los niveles. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.4333" lon="-16.4253">
    <name>Las Raíces – Corona Forestal (PR-TF 25.1)</name>
    <desc>Agradable ruta por el bosque de Las Esperanzas en la Corona Forestal. Pino canario y eucalipto en la zona donde Franco planificó el alzamiento. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5742" lon="-16.2003">
    <name>Taborno – Carboneras – Llano Frío</name>
    <desc>Circular completa por el corazón de Anaga: Taborno, Carboneras, Chinamada, Llano Frío y vuelta por el PR-TF 2. Exige orientación y buen calzado. | Tenerife | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0044" lon="-16.6911">
    <name>Montaña Amarilla – Punta de Panete</name>
    <desc>Circular corta al Monumento Natural de Montaña Amarilla. Capas de colores volcánicos entre la montaña y el océano. Puesta de sol espectacular. | Tenerife | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9694" lon="-15.5772">
    <name>Roque Nublo – Tejeda (Circular)</name>
    <desc>La ruta más emblemática de Gran Canaria. Desde Tejeda al monolito volcánico de 1.813 m. Desde 2025 requiere reserva previa en la web oficial. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.975" lon="-15.5853">
    <name>Degollada Becerra – Roque Nublo</name>
    <desc>Acceso al Roque Nublo desde la Degollada Becerra pasando por el Roque de La Rana y El Fraile. Vistas a Artenara y Acusa. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.965" lon="-15.5908">
    <name>Llanos de la Pez – Pico de las Nieves – Roque Nublo (S-51)</name>
    <desc>Circular por las cumbres de GC desde el área recreativa de Llanos de la Pez. Pico de las Nieves (1.949 m) y Roque Nublo en una sola ruta. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9717" lon="-15.5669">
    <name>Ascensión al Pico de las Nieves</name>
    <desc>Subida al techo de Gran Canaria (1.949 m) desde el área recreativa de Tamadaba por pinar antiguo. Vistas al Roque Nublo, Bentayga y el Teide. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0117" lon="-15.6425">
    <name>Artenara – Cuevas del Caballero</name>
    <desc>Circular desde Artenara, el pueblo más alto de Gran Canaria. Bosques, crestas y las cuevas guanches del Caballero con leyendas locales. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9872" lon="-15.6153">
    <name>Roque Bentayga – Yacimiento Aborigen</name>
    <desc>Sendero hasta el lugar sagrado de los aborígenes canarios. Almogarenes, grabados rupestres y vistas al Roque Nublo y a la cuenca de Tejeda. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9708" lon="-15.4853">
    <name>Caldera de Los Marteles – Tenteniguada (SL-1)</name>
    <desc>Circular oficial SL-1 por la Caldera de Los Marteles con vistas al Pico de las Nieves. Almendros en flor en enero–febrero, paisaje único. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8997" lon="-15.4025">
    <name>Barranco de Guayadeque</name>
    <desc>Monumento Natural con cientos de cuevas aborígenes, ermita rupestre y restaurantes-cueva. Vegetación exuberante. Acceso con reserva desde 2025. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8792" lon="-15.7228">
    <name>Barranco de Güigüi – Playa Virgen</name>
    <desc>Una de las rutas más salvajes de Gran Canaria. Desciende al Barranco de Güigüi hasta una playa virgen inaccesible por carretera. Llevar mucha agua. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.95" lon="-15.4167">
    <name>Barranco de los Cernícalos</name>
    <desc>El barranco más húmedo de Gran Canaria. Cascadas, helechos gigantes y cernícalos sobrevolando el cauce. Muy verde y fresco todo el año. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0181" lon="-15.4458">
    <name>Caldera de Bandama – Circular</name>
    <desc>Borde e interior de la Caldera de Bandama, cráter de 200 m de profundidad y 1 km de diámetro. Viñedos históricos en el fondo del cráter. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8883" lon="-15.6136">
    <name>Presa de Soria – Cascada</name>
    <desc>Ruta por zona semidesértica hasta la Presa de las Niñas. Cuando llueve se forma una cascada espectacular. Casi sin sombra, llevar protección solar. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8381" lon="-15.5597">
    <name>Barranco de Fataga – Parque Natural Ayagaures</name>
    <desc>Por el Parque Natural de Ayagaures en los alrededores del barranco de Fataga. Paisaje de palmeras canarias y acantilados ocres en el sur. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8683" lon="-15.6019">
    <name>Parque Natural de Pilancones</name>
    <desc>Circular por el Parque Natural de Pilancones desde la Presa de la Angostura. Pino canario centenario y paisajes volcánicos del sur interior. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0833" lon="-15.6667">
    <name>Circular Parque Natural de Tamadaba</name>
    <desc>Circular completa por el macizo de Tamadaba: pinos centenarios, Montaña Bibique, Presa de los Pérez y el Valle de Agaete. Impresionante. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0994" lon="-15.7094">
    <name>Agaete – Tamadaba (Lineal)</name>
    <desc>Ascenso desde Agaete al pinar de Tamadaba por el Camino de los Romeros. Perfecta para hacer solo ida y volver en guagua. Vistas al océano. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0994" lon="-15.7094">
    <name>Valle de Agaete – El Sao</name>
    <desc>Por el Valle de Agaete hasta el barrio de El Sao y el Hornillo por caminos históricos. Frutales, riscos y el pinar de Tamadaba al fondo. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9178" lon="-15.7356">
    <name>Los Azulejos – Reserva Natural de Inagua</name>
    <desc>Ruta por las rocas multicolores de Los Azulejos hasta la Reserva Natural Integral de Inagua. Paisaje único de colores volcánicos amarillos y verdes. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1248" lon="-15.43">
    <name>GR 131 – Camino Entre Volcanes</name>
    <desc>Gran travesía norte–sur por el corazón volcánico de Gran Canaria. Barrancos, cumbres y bosques encadenados. Una de las mejores de Canarias. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1248" lon="-15.43">
    <name>Ruta Jacobea Canaria – Etapa 1</name>
    <desc>Primera etapa del Camino de Santiago por Gran Canaria. Cruza la isla por pueblos históricos y paisajes volcánicos únicos de norte a sur. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7397" lon="-15.5761">
    <name>Dunas de Maspalomas</name>
    <desc>Reserva Natural con dunas de hasta 10 m y laguna salobre. 8 km de senderos oficiales delimitados. Prohibido salirse del camino marcado. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9025" lon="-15.3608">
    <name>Playa del Cabrón – Playa Cuervo Grande</name>
    <desc>Ruta costera por el litoral del este. Paisaje volcánico con tonos rojizos y turquesas. Ideal para combinar con baño en playas poco frecuentadas. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8008" lon="-15.7283">
    <name>Playa de Amadores – Playa de Tauro</name>
    <desc>Paseo costero entre las playas más populares del suroeste. Acantilados de colores rojizos y vistas al Atlántico con parada en playa virgen. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8253" lon="-15.7703">
    <name>Puerto de Mogán – Paseo Costero</name>
    <desc>Agradable paseo por el puerto histórico de Mogán, sus playas y acantilados. El pueblo más pintoresco del suroeste de Gran Canaria. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1008" lon="-15.4267">
    <name>Barranco del Guiniguada – Las Palmas</name>
    <desc>Sendero urbano–natural desde Las Palmas hasta casi el Jardín Canario. El barranco más accesible de la isla, rehabilitado y bien señalizado. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0594" lon="-15.5044">
    <name>Circular de Firgas</name>
    <desc>Circular técnica por los alrededores de Firgas con tramos estrechos, expuestos y embarrados. Descargar mapa antes de salir. Paisaje muy variado. | Gran Canaria | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.9794" lon="-15.5622">
    <name>Patrimonio Arqueológico La Fortaleza</name>
    <desc>Ruta corta por el yacimiento arqueológico de La Fortaleza. Plantaciones de almendros y el lugar donde se conmemora la conquista de la isla. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7906" lon="-15.7072">
    <name>Puerto Rico – Palmeral Noruego</name>
    <desc>Ruta de trail muy expuesta con escaleras y piedra suelta desde Puerto Rico. Buenas vistas al mar y al interior de la isla. Apta para corredores. | Gran Canaria | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7594" lon="-15.5608">
    <name>Playa del Inglés – San Agustín (Costa)</name>
    <desc>Paseo costero accesible entre Playa del Inglés y el Balcón de San Agustín. Vistas al Atlántico, bares con terraza y ambiente playero. | Gran Canaria | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0077" lon="-13.7588">
    <name>Caldera Blanca – Circular desde Tinajo</name>
    <desc>La ruta libre más impresionante de Lanzarote. Coladas de lava hasta el cráter más grande de la isla (1.200 m de diámetro). Sin guía obligatorio. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.018" lon="-13.763">
    <name>Ruta de los Volcanes – Timanfaya</name>
    <desc>Sendero oficial del Parque Nacional (lun/mié/vie). Acceso entre cráteres, coladas de lava y ceniza. Requiere reserva previa obligatoria. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0433" lon="-13.8294">
    <name>El Golfo – Ruta del Litoral</name>
    <desc>Sendero lineal desde El Golfo hasta la Playa del Paso por la costa de lava solidificada. Ruta guiada oficial del PN de Timanfaya (miércoles). | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1714" lon="-13.4675">
    <name>Volcán de La Corona – Desde Yé</name>
    <desc>Circular desde Yé hasta el cráter del Monte Corona (609 m), el volcán que originó el mayor tubo volcánico de Europa. Vistas a La Graciosa. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1556" lon="-13.5422">
    <name>Peñas del Chache – Punto más alto</name>
    <desc>Ascenso al punto más alto de Lanzarote (670 m). Vistas espectaculares al acantilado de Famara y a La Graciosa. Sin sombra, llevar agua. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2133" lon="-13.4781">
    <name>Risco de Famara – Mirador del Río</name>
    <desc>Bajada por el Risco de Famara desde el Mirador del Río de César Manrique hasta la playa. Vistas a La Graciosa y pendiente pronunciada. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1317" lon="-13.4919">
    <name>Haría – El Bosquecillo – Mirador</name>
    <desc>Valle de las Mil Palmeras hasta El Bosquecillo, uno de los pocos bosques naturales de Lanzarote. Contraste total: palmeras, pinos y volcán. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1317" lon="-13.4919">
    <name>Haría – Subida al Mirador</name>
    <desc>Desde el pueblo blanco de Haría hasta un mirador con vistas al océano. Camino cómodo con paisaje de palmeras canarias y vegetación norteña. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0917" lon="-13.4883">
    <name>GR 131 Lanzarote – Tramo Norte</name>
    <desc>Tramo del GR 131 entre Guatiza y Famara por campos de cactus, malpaíses y el paisaje lunar del norte. Ruta oficial bien señalizada. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1544" lon="-13.4856">
    <name>Ruta al Cráter de Santa Catalina</name>
    <desc>7 km hasta el cráter de Santa Catalina por paisaje volcánico único. Solo 9 personas por salida. Ruta guiada muy valorada en el norte. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9819" lon="-13.6614">
    <name>La Geria – Viñedos Volcánicos</name>
    <desc>Ruta por la zona vinícola única en el mundo: uvas cultivadas en hoyos de ceniza volcánica negra. Combina senderismo y enoturismo en bodegas. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9744" lon="-13.6667">
    <name>Montaña Colorada – Volcán Rojo</name>
    <desc>Circular bien señalizado alrededor del volcán de color rojizo por óxidos de hierro. Con la Caldereta adyacente donde se cultivaron cereales. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9656" lon="-13.6922">
    <name>Caldera de los Cuervos – Montaña Negra</name>
    <desc>Vista única desde el interior del cráter de Los Cuervos. Bien conservado, rápido y con vistas panorámicas. Terreno polvoriento y seco. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9211" lon="-13.6733">
    <name>Montaña Blanca – Las Grietas</name>
    <desc>Sendero muy popular hasta Las Grietas, cañones volcánicos estrechos con paredes onduladas. Terreno resbaladizo, llevar calzado con grip. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.8617" lon="-13.8394">
    <name>Montaña Roja – Sur de Lanzarote</name>
    <desc>Circular de 3 km por el cráter de Montaña Roja en el sur. Vistas a Playa Blanca, Papagayo y Faro Pechiguera. Ruta en sentido antihorario. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.8672" lon="-13.7617">
    <name>Los Ajaches – Cima y Caldera Colorada</name>
    <desc>Ruta dura al punto más alto de Los Ajaches. Caldera Colorada, la bomba volcánica más grande del mundo y vistas a toda la costa sur. | Lanzarote | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.8672" lon="-13.7617">
    <name>Macizo de Los Ajaches – Barrancos</name>
    <desc>Por la zona más antigua de Lanzarote: barrancos, playas vírgenes y miradores sobre el macizo. Paisaje semiárido con flora endémica. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1983" lon="-13.5111">
    <name>Risco de Famara – Playa del Risco</name>
    <desc>Bajada desde el acantilado hasta la solitaria Playa del Risco. Vistas a La Graciosa en el descenso. Pendiente considerable, buen calzado. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.8625" lon="-13.8144">
    <name>Playa Blanca – Papagayo (Costera)</name>
    <desc>Paseo costero desde Playa Blanca hasta las calas de Papagayo por acantilados volcánicos. Termina en la cala más espectacular del sur. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.8514" lon="-13.8278">
    <name>Kayak – Playas de Papagayo</name>
    <desc>Ruta en kayak por las cristalinas calas de Papagayo con paradas para snorkel en fondos volcánicos. Una de las mejores experiencias acuáticas. | Lanzarote | Kayak | Fácil</desc>
    <type>Kayak</type>
  </wpt>
  <wpt lat="28.9983" lon="-13.5089">
    <name>Costa Teguise – Ruta de Playas</name>
    <desc>Circular costera desde Costa Teguise por Playa de las Cucharas, Los Charcos y Jabilillo. Zona turística con ambiente playero y accesos fáciles. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9635" lon="-13.5478">
    <name>Arrecife – Paseo Marítimo y Charco</name>
    <desc>Agradable paseo por la capital: Parque Temático, Playa del Reducto, Castillo de San Gabriel y el encantador Charco de San Ginés. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9231" lon="-13.6694">
    <name>Puerto Calero – Puerto del Carmen</name>
    <desc>Sendero costero desde Puerto Calero hasta Puerto del Carmen por el Mirador del Puerto, Barranco Quiquere y Playa Pila de la Barrilla. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.1317" lon="-13.4919">
    <name>Valles del Norte – Haría</name>
    <desc>Caminata guiada por los valles del norte de Lanzarote. Paisajes increíbles, fauna endémica y el mercado de Haría al finalizar. Traslados incluidos. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.9" lon="-13.72">
    <name>Cara Sur – Volcanes y Costa</name>
    <desc>Ruta guiada por la cara sur de Lanzarote: volcanes, fauna y vistas espectaculares. Nivel de dificultad 4. 5 horas de recorrido intenso. | Lanzarote | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0583" lon="-13.5619">
    <name>Castillo de Santa Bárbara – Teguise</name>
    <desc>Subida al Castillo de Santa Bárbara en lo alto de la Montaña de Guanapay. Vistas panorámicas a Teguise, la antigua capital, y la costa este. | Lanzarote | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0694" lon="-13.6533">
    <name>La Santa – Tenesar</name>
    <desc>Recorrido de 7 km por paisaje volcánico con acantilados pronunciados desde La Santa hasta Tenesar. Tranquilidad total y vistas al Atlántico. | Lanzarote | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.0917" lon="-13.4883">
    <name>GR 131 Lanzarote – Travesía</name>
    <desc>Travesía completa de norte a sur por Lanzarote. Volcanes, malpaíses, viñedos y costas. La gran ruta de largo recorrido de la isla. | Lanzarote | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6572" lon="-13.9203">
    <name>Calderón Hondo – Lajares (SL-FV 2)</name>
    <desc>La ruta más popular de Fuerteventura. Cráter perfectamente dibujado (278 m) con vistas a Lobos, Lanzarote y el Atlántico. Bien señalizada. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0956" lon="-14.3783">
    <name>Pico de la Zarza – Morro Jable (PR-FV 54)</name>
    <desc>Ascenso al punto más alto de Fuerteventura (807 m) con vistas a Cofete, las playas vírgenes y en días despejados hasta Gran Canaria. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0703" lon="-14.3972">
    <name>Cofete – Gran Valle (PR-FV 55)</name>
    <desc>Una de las mejores rutas de Fuerteventura. Desciende por el Gran Valle hasta la playa salvaje de Cofete, 12 km de arena virgen. Muy exigente. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3939" lon="-14.145">
    <name>Arco de las Peñitas – Barranco Malpaso (SL-FV 6)</name>
    <desc>Sendero hasta el Arco de las Peñitas por el barranco de Malpaso. Escalar piedras grandes, vegetación idílica y la Ermita de la Peña. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3733" lon="-14.0567">
    <name>Betancuria – Barranco de Las Peñitas (SL-FV 27)</name>
    <desc>Ruta patrimonial por el cauce del río Palmas hasta la Ermita de la Virgen de la Peña, patrona de Fuerteventura. Los materiales más antiguos de Canarias. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3587" lon="-14.0531">
    <name>GR 131 Fuerteventura – Travesía Completa</name>
    <desc>152 km atravesando toda la isla de norte a sur entre volcanes, viento y largas etapas sin sombra. La gran travesía de Fuerteventura. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5919" lon="-13.9969">
    <name>Montaña de Tindaya</name>
    <desc>Ascenso a la montaña sagrada de los majos con grabados podomorlos únicos. Vistas al norte de la isla. Lugar de alto valor arqueológico y espiritual. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6208" lon="-13.9011">
    <name>Malpaís de la Arena – Norte</name>
    <desc>Circular por el cono volcánico del Malpaís de la Arena rodeado de coladas de lava. Vistas hacia Corralejo y el Atlántico. Flora resistente al clima árido. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5722" lon="-14.0194">
    <name>Volcán de Escanfraga</name>
    <desc>Ascenso al volcán de Escanfraga con coladas basálticas y lavas solidificadas. Vistas al norte de la isla y contraste con las extensas llanuras. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3939" lon="-14.1692">
    <name>Ajuy – Caleta Negra y Cuevas Marinas</name>
    <desc>Ruta costera a las cuevas marinas de Ajuy y los acantilados de Caleta Negra. Los materiales más antiguos de Canarias a nivel del mar. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1294" lon="-14.2292">
    <name>Kitesurf – Laguna de Sotavento</name>
    <desc>Sede del Mundial de Windsurf y Kitesurf. Laguna con aguas tranquilas y viento constante. Uno de los mejores spots de estos deportes en el mundo. | Fuerteventura | Surf | Media</desc>
    <type>Surf</type>
  </wpt>
  <wpt lat="28.7361" lon="-13.8636">
    <name>Parque Natural de Corralejo – Dunas</name>
    <desc>Sendero por las grandes dunas blancas del norte junto al Parque Natural de Corralejo. Paisaje desértico con vistas a Lobos y Lanzarote. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2164" lon="-14.0133">
    <name>Costa de Gran Tarajal – Ruta Costera</name>
    <desc>Paseo costero por el sur entre playas tranquilas y acantilados de colores ocres. Zona alejada del turismo masivo con vistas al océano Atlántico. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6069" lon="-13.9592">
    <name>Playa de Los Molinos</name>
    <desc>Ruta hasta la Playa de Los Molinos con la Cueva Herminia visible solo en bajamar. Paisaje volcánico y tranquilidad absoluta en el noroeste. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7506" lon="-13.8167">
    <name>Ruta Circular – Isla de Lobos</name>
    <desc>Circular completa por Lobos: La Caldera, El Puertito, Faro Martiño y Playa de La Concha. Requiere permiso gratuito y ferry desde Corralejo. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6511" lon="-13.8869">
    <name>Sendero Bayuyo – Malpaís Norte</name>
    <desc>Ruta por el enorme malpaís de lava del norte, producto de una erupción hace 10.000 años. Vistas a Lanzarote, Lobos y el Atlántico desde los conos volcánicos. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.4167" lon="-14">
    <name>Barrancos de Puerto – Centro</name>
    <desc>Circular por los barrancos del centro de la isla con 268 m de desnivel. Paisaje variado entre malpaíses, barrancos y llanuras volcánicas poco frecuentadas. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.3833" lon="-14.0167">
    <name>Balcón de La Asomada</name>
    <desc>Ruta con vistas panorámicas desde el Balcón de La Asomada. Paisaje desértico árido con vistas al Atlántico. Sendero poco frecuentado ideal para la tranquilidad. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.35" lon="-14.0333">
    <name>Degollada de Facay</name>
    <desc>Una de las rutas más largas y exigentes del centro de Fuerteventura con 520 m de desnivel. Atraviesa paisajes volcánicos remotos con gran sensación de aislamiento. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1833" lon="-14.2667">
    <name>Risco del Paso – Parque Natural Jandía</name>
    <desc>Circular técnica no apta para vértigo por Atalayeja Grande, Morro del Rinconcillo y la Playa Barlovento. Ruinas guanchas y vistas al Atlántico sur. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0833" lon="-14.3667">
    <name>Morro de La Zona – Cumbre Jandía</name>
    <desc>Ascenso por la sierra de Jandía al Morro de La Zona con vistas a Cofete y las playas vírgenes del sur. Paisaje abrupto con barrancos y montañas de 800 m. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.575" lon="-13.9917">
    <name>Tindaya – Vallebrón – Tefía (PR FV 9)</name>
    <desc>Larga circular desde Tindaya pasando por Vallebrón y Tefía. Montaña de Tindaya, Ermita de San Juan, Montaña de la Muda y vistas al norte de la isla. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2167" lon="-13.9833">
    <name>Las Playitas – Costa Sur Este</name>
    <desc>Circular con subibajas constantes y vistas a la costa este. Paisaje volcánico rojizo, playas poco frecuentadas y la sensación de explorar el sur más tranquilo. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.15" lon="-14.2083">
    <name>Arenal Playa de Sotavento – Circular</name>
    <desc>Circular por el arenal de la Playa de Sotavento en Costa Calma. Laguna natural, dunas y el entorno donde se celebran los mundiales de kitesurf y windsurf. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2208" lon="-13.9972">
    <name>Salinas del Carmen – Ruta Costera</name>
    <desc>Paseo junto a las antiguas salinas del Carmen en el este de la isla. Museo de la Sal y paisaje costero único con aves limícolas en las balsas salineras. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.715" lon="-13.87">
    <name>Costa Norte – Corralejo</name>
    <desc>Ruta costera desde Corralejo por el GR-131 junto a las Dunas del Parque Natural, con vistas a Lobos y Lanzarote. Sendero de arena bien marcado. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6083" lon="-13.9583">
    <name>Montaña de Cardones – La Oliva</name>
    <desc>Ruta circular desde La Oliva hasta la Montaña de Cardones. Paisaje semidesértico poco frecuentado con vistas a los pueblos blancos del norte. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.4233" lon="-14.0567">
    <name>Betancuria – Vega Río Palmas</name>
    <desc>Paseo histórico desde Betancuria, la antigua capital, hasta la Vega de Río Palmas por el barranco del Río Palmas. Agua, palmeras y la Ermita de la Peña. | Fuerteventura | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.2017" lon="-14.0017">
    <name>Gran Tarajal – Caleta del Muerto</name>
    <desc>Ruta costera por acantilados volcánicos del sureste desde Gran Tarajal. Calas solitarias, colores rojizos y el silencio de la costa menos visitada. | Fuerteventura | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1167" lon="-14.3333">
    <name>Barranco de Pecenescal – Playa Barlovento</name>
    <desc>Sendero GR-131/SL-FV11 técnico con tramos de mucho desnivel hasta la Playa Barlovento. No apta para vértigo. Paisaje salvaje del Parque Natural de Jandía. | Fuerteventura | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5256" lon="-17.8589">
    <name>Ruta de los Volcanes – GR 131</name>
    <desc>Ruta mítica desde el Refugio del Pilar por cráteres volcánicos hasta Fuencaliente. El Cráter del Hoyo Negro, vistas al Teide y la Gomera. | La Palma | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6114" lon="-17.8644">
    <name>Volcán Tajogaite – Erupción 2021</name>
    <desc>Paisaje lunar reciente único en Europa. Coladas y el nuevo delta volcánico formado en 2021. La más impresionante y reciente de las rutas canarias. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7118" lon="-17.8636">
    <name>Los Brecitos – Cascada de Colores</name>
    <desc>Descenso desde Los Brecitos (taxi 4x4) por el Parque Nacional hasta la Cascada de Colores y el Barranco de las Angustias. Espectacular. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.76" lon="-17.83">
    <name>Nacientes de Marcos y Cordero – Túneles</name>
    <desc>Sendero PR-LP 6 por el canal con 13 túneles. El túnel 12 tiene una cascada interior. Laurisilva increíble en el descenso. Requiere frontal y chubasquero. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6401" lon="-17.9356">
    <name>Tazacorte – Roque de los Muchachos</name>
    <desc>Más de 2.400 m de ascenso continuo desde el mar hasta la cima de La Palma (2.423 m). Una de las rutas más duras de todo el archipiélago. | La Palma | Senderismo | Extrema</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7544" lon="-17.8833">
    <name>Roque de los Muchachos – Cumbre GR 131</name>
    <desc>Tramo del GR 131 por la cumbre (2.423 m) entre observatorios. Desde el Pico de la Cruz al Roque, con vistas a todas las islas del archipiélago. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7803" lon="-17.7886">
    <name>Ruta de Los Tilos – Bosque Sagrado</name>
    <desc>Bosque de laurisilva Reserva de la Biosfera con el Salto de los Tilos. Vegetación endémica exuberante y sonido del agua constante. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.79" lon="-17.805">
    <name>El Tablado – Gallegos (Costa Norte)</name>
    <desc>Costa norte salvaje entre barrancos y acantilados, plantaciones en terrazas y caseríos remotos. Gran sensación de aislamiento. Solo ida. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.59" lon="-17.8394">
    <name>Pico de La Sabina – Pico de la Nieve (PR-LP 3)</name>
    <desc>Circular por los picos del sur de la cumbre. Bosques de pinos y matorrales, vistas a Tenerife y La Gomera. Mejor en sentido antihorario. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7118" lon="-17.8636">
    <name>Travesía Integral – Caldera de Taburiente</name>
    <desc>Travesía completa del Parque Nacional. Barrancos, cascadas, paredes de 2.000 m y uno de los paisajes más impresionantes de Canarias. | La Palma | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.4578" lon="-17.8453">
    <name>Volcán de San Antonio – Fuencaliente</name>
    <desc>Sendero muy accesible alrededor del cráter del Volcán de San Antonio. Vistas al nuevo delta del Tajogaite y al faro de Fuencaliente. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.5614" lon="-17.7972">
    <name>Camino de la Faya – Medianías Este</name>
    <desc>Sendero panorámico por las medianías del este conectando los pinares. Vistas al Atlántico y a los valles. Flora endémica de medianías. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7694" lon="-17.7819">
    <name>El Cubo de La Galga – PR LP 5.1</name>
    <desc>Sendero por el bosque más húmedo del noreste de La Palma. Laurisilva densa, helechos gigantes y el sonido constante del agua en el barranco de La Galga. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.55" lon="-17.85">
    <name>Refugio El Pilar – Pico Birigoyo</name>
    <desc>Ascenso al Pico Birigoyo (1.800 m) desde el Refugio del Pilar por el GR 131. Vistas a la Ruta de los Volcanes y a la Caldera de Taburiente desde la cima. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7" lon="-17.875">
    <name>Mirador de La Cumbrecita – Caldera</name>
    <desc>Ruta panorámica desde el Mirador de La Cumbrecita al borde de la Caldera de Taburiente. Vistas aéreas al interior del parque. Requiere reserva de aparcamiento. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7917" lon="-17.8444">
    <name>Charco Azul – Piscinas Naturales</name>
    <desc>Paseo corto hasta las piscinas naturales volcánicas de Charco Azul en el norte. Agua turquesa y tranquilidad absoluta rodeada de acantilados de lava. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.6886" lon="-17.9283">
    <name>Barranco de Las Angustias</name>
    <desc>Descenso por el cauce del Barranco de Las Angustias, salida de la Caldera de Taburiente. Cruzar el río varias veces sobre piedras. Tramo final muy exigente. | La Palma | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.59" lon="-17.8394">
    <name>Pico de La Sabina – Pico de la Nieve (PR LP 3)</name>
    <desc>Circular bien marcada por los picos del sur de la cumbre. Bosques de pinos, chovas piquirrojas y vistas a Tenerife y La Gomera en días despejados. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7544" lon="-17.8833">
    <name>Pico de la Cruz – Roque de los Muchachos (GR 131)</name>
    <desc>Tramo del GR 131 por la crestería a más de 2.300 m. Vistas a la Caldera, Mirador de Los Andenes y el observatorio astronómico más importante del hemisferio norte. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.79" lon="-17.805">
    <name>El Tablado – Gallegos (Costa Norte)</name>
    <desc>Costa norte salvaje entre barrancos, acantilados y caseríos remotos. Gran sensación de aislamiento. Hacer solo ida y volver en guagua desde Gallegos. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.72" lon="-17.86">
    <name>Pico de las Nieves – Reventón (GR 131)</name>
    <desc>Ruta de altura desde el Pico de las Nieves (2.239 m) hasta el Paso del Reventón. Cornisas con vistas espectaculares. No apta para vértigo. Llevar abrigo. | La Palma | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.76" lon="-17.83">
    <name>Nacientes de Marcos y Cordero – 13 Túneles</name>
    <desc>El sendero PR-LP 6 más emblemático de La Palma. 13 túneles por canal de agua, cascada en el túnel 12. Requiere frontal y chubasquero. Reserva de aparcamiento. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7803" lon="-17.7886">
    <name>Bosque de Los Tilos – Reserva</name>
    <desc>Paseo por la Reserva de la Biosfera de Los Tilos. Laurisilva Patrimonio de la Humanidad con la cascada del Salto de los Tilos. Sendero llano y muy verde. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.4483" lon="-17.8417">
    <name>Playa Puntalarga – Fuencaliente</name>
    <desc>Paseo hasta la Playa de Puntalarga, pequeña bahía de arena negra volcánica en Fuencaliente. Aguas tranquilas perfectas para baño. Junto al Volcán de San Antonio. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.51" lon="-17.8433">
    <name>Cráter del Hoyo Negro – Ruta Volcanes</name>
    <desc>Tramo central de la Ruta de los Volcanes con el imponente Cráter del Hoyo Negro. Colores negros y rojizos, lava solidificada y el silencio de los volcanes. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.62" lon="-17.91">
    <name>Jedey – Los Llanos de Aridane</name>
    <desc>Ruta por los barrancos del Valle de Aridane con vistas a las coladas del Tajogaite 2021. Plataneras, senderos históricos y paisaje en regeneración volcánica. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.75" lon="-17.82">
    <name>Barranco de Las Bombas de Agua</name>
    <desc>Circular por el norte de La Palma entre plataneras, barrancos y el contraste entre vegetación exuberante y acantilados costeros. Sendero poco frecuentado. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.44" lon="-17.86">
    <name>Punta de La Lava – Delta Tajogaite</name>
    <desc>Sendero por el delta volcánico creado en 2021, donde la lava llegó al mar y creó 50 hectáreas de tierra nueva. El paisaje más reciente y único de Europa. | La Palma | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.71" lon="-17.88">
    <name>Mirador Lomo de Las Chozas – Caldera</name>
    <desc>Sendero con tramos junto a cornisas del borde de la Caldera de Taburiente hasta el Mirador de Los Roques. Precaución en este tramo por el acantilado. | La Palma | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7833" lon="-17.8">
    <name>Ruta Costera Norte – Barlovento</name>
    <desc>Costa norte salvaje de La Palma desde Barlovento. Acantilados, cuevas marinas y el paisaje atlántico más bravo de la isla. Poco señalizado, descargar mapa GPS. | La Palma | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1142" lon="-17.2456">
    <name>Alto de Garajonay – Cima del Parque Nacional</name>
    <desc>Cima del Parque Nacional (1.487 m) por laurisilva milenaria. Vistas a todas las islas en días claros. El bosque más antiguo de Europa. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1073" lon="-17.2452">
    <name>GR 131 La Gomera – Travesía</name>
    <desc>Atraviesa el Parque Nacional de Garajonay y los barrancos más profundos de La Gomera. Jornada exigente por la joya verde del archipiélago. | La Gomera | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1847" lon="-17.2767">
    <name>Las Portelas – Monte del Agua</name>
    <desc>Laurisilva muy bien conservada en el Parque Rural de Teno gomero. Vistas al norte de La Gomera y senderos de niebla únicos en Europa. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0947" lon="-17.3253">
    <name>Barranco de Valle Gran Rey</name>
    <desc>Descenso por el barranco más profundo de La Gomera hasta las playas de Valle Gran Rey. Paredes verticales y vegetación exuberante. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1878" lon="-17.2633">
    <name>Roque Cano – Vallehermoso</name>
    <desc>Ascenso hasta la formación basáltica que domina Vallehermoso. Vistas al norte de La Gomera y al océano Atlántico desde el roque. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0833" lon="-17.1133">
    <name>GR 132 La Gomera – Vuelta a la Costa</name>
    <desc>Gran ruta que rodea toda la isla por la costa norte. Acantilados, barrancos y pueblos remotos. Uno de los caminos más épicos de Canarias. | La Gomera | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0833" lon="-17.2167">
    <name>Benchijigua – Barranco Seco</name>
    <desc>Ruta por el corazón de La Gomera hasta Benchijigua, uno de los paisajes más dramáticos con roques basálticos y vegetación de medianías. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.07" lon="-17.1367">
    <name>Kayak – Costa Sur La Gomera</name>
    <desc>Ruta en kayak por la costa sur de La Gomera con acantilados, cuevas marinas y aguas cristalinas. Fauna marina abundante. | La Gomera | Kayak | Fácil</desc>
    <type>Kayak</type>
  </wpt>
  <wpt lat="28.1153" lon="-17.2369">
    <name>Laguna Grande – Circular Garajonay</name>
    <desc>Circular desde La Laguna Grande por el Parque Nacional. Bosque de laurisilva con musgo y helechos gigantes. Ruta familiar bien señalizada y muy fotogénica. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.11" lon="-17.25">
    <name>Las Creces – Circular Garajonay (Ruta 5)</name>
    <desc>El paraje de Las Creces por el bosque de laurisilva más pristino. Los vecinos venían a recolectar leña. Atmósfera de niebla, musgos y árboles centenarios. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.12" lon="-17.24">
    <name>Raso de La Bruma – Fayal Brezal</name>
    <desc>Paseo corto pero mágico por fayal-brezal atlántico. Árboles con líquenes, helechos y niebla persistente. Ideal para familias o como calentamiento del día. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.118" lon="-17.242">
    <name>Cañada de Jorge</name>
    <desc>Corta ruta por fayal-brezal en el sur del Parque de Garajonay. Canal histórico de agua en el fondo del barranco. Perfecta para completar la ruta del Raso. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0608" lon="-17.2192">
    <name>Alajeró – Playa de Santiago (Camino de La Costa)</name>
    <desc>Camino Natural de la Costa entre Alajeró y Playa de Santiago. Barrancos profundos, bancales históricos y el Roque Agando dominando el horizonte. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0947" lon="-17.3253">
    <name>Barranco de Arure – Valle Gran Rey</name>
    <desc>Descenso técnico por el Barranco de Arure con trepadas y saltos entre piedras. El paisaje cambia de palmeras a laurisilva húmeda. Requiere buen calzado. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0833" lon="-17.2167">
    <name>Barranco de Guarimiar – Imada</name>
    <desc>Desde Imada (1.200 m) bajando por bancales de piedra seca y laderas escarpadas hacia el Barranco de Guarimiar. Arquitectura rural única en arquitectura gomera. | La Gomera | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0994" lon="-17.2156">
    <name>Roque Agando – Mirador</name>
    <desc>Corto paseo hasta el mirador del Roque Agando, el monolito basáltico más famoso de La Gomera. Vistas al sur de la isla y al barranco de Santiago. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1073" lon="-17.2452">
    <name>Gran Circular Garajonay (Ruta 18)</name>
    <desc>Circular completa por el corazón del Parque Nacional. Pajarito, Contadero, Mimbreras, Cedro, Reventón Oscuro y Tajaqué. La ruta más completa del parque. | La Gomera | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.11" lon="-17.25">
    <name>Igualero – Alto de Garajonay</name>
    <desc>Ascenso al Alto de Garajonay desde Igualero por el GR 131 y el Camino El Contadero. Vistas a La Palma, Tenerife, El Hierro y La Palma desde la cima. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1878" lon="-17.2633">
    <name>Vallehermoso – Tamargada – Garabato</name>
    <desc>Circular por los alrededores de Vallehermoso. Escaleras seminaturales talladas en roca, embalse de la Encantaderos y vegetación que invade los senderos. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.095" lon="-17.22">
    <name>Los Roques – Mirador Paisaje Lunar</name>
    <desc>Ruta entre los Roques de La Gomera — Agando, Zarcita, Ojila y La Caldera — formaciones basálticas únicas en el interior de la isla. Muy fotogénico. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.06" lon="-17.19">
    <name>Playa de Santiago – Trekking Costa Sur</name>
    <desc>Ruta costera desde Playa de Santiago hacia el este. Acantilados volcánicos, playas de arena negra y el contraste árido del sur de la isla. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0919" lon="-17.1119">
    <name>San Sebastián – Garajonay (GR 132 tramo)</name>
    <desc>Ascenso desde la capital San Sebastián hasta el Parque Nacional de Garajonay por caminos históricos. Aldeas, bancales y bosques en el camino a las nubes. | La Gomera | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1911" lon="-17.1939">
    <name>Drago de Agulo – Circular</name>
    <desc>Ruta desde Agulo por senderos entre plataneras y dragos hasta miradores con vistas al Teide. El pueblo más fotogénico de La Gomera con arquitectura única. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1167" lon="-17.2333">
    <name>El Cedro – Chorro del Cedro</name>
    <desc>Circular por laurisilva en el corazón de Garajonay. El Chorro del Cedro es la única cascada permanente de La Gomera, en un entorno de bosque mágico y húmedo. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0628" lon="-17.2892">
    <name>Chipude – Valle Gran Rey (GR-132)</name>
    <desc>Desde Chipude con vistas a La Fortaleza, bajada por La Matanza y El Cercado hasta el Barranco de Argaga y las playas de Valle Gran Rey. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1878" lon="-17.2633">
    <name>Vallehermoso – Hermigua por Garajonay</name>
    <desc>Conecta dos de los pueblos más bonitos del norte atravesando el Parque Nacional de Garajonay. Desnivel de 600 m, laurisilva densa y vistas al norte de la isla. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.0408" lon="-17.2317">
    <name>Alajeró – Playa de Santiago (Ruta 7)</name>
    <desc>Camino Natural de la Costa desde Alajeró hasta Playa de Santiago. Barrancos, acantilados y caseríos históricos. El sur más salvaje de La Gomera. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.11" lon="-17.24">
    <name>Raso de la Bruma – Circular Garajonay</name>
    <desc>Paseo fácil por fayal-brezal y laurisilva desde el área recreativa del Raso de la Bruma. Ideal para familias. Árboles cubiertos de musgo y helechos gigantes. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.105" lon="-17.245">
    <name>Cañada de Jorge – Garajonay</name>
    <desc>Sendero corto por fayal-brezal en la vertiente sur de Garajonay. Canal histórico de agua en el fondo del barranco. Complemento perfecto al Raso de la Bruma. | La Gomera | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.1303" lon="-17.2761">
    <name>Las Hayas – Vallehermoso (GR 131)</name>
    <desc>Tramo del GR 131 por el norte de La Gomera con bajada por escaleras naturales talladas en la roca. Vistas a la Presa de la Encantadora y al océano. | La Gomera | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7914" lon="-18.0311">
    <name>Camino de Jinama</name>
    <desc>Ruta legendaria: 1.000 m de desnivel en 4 km. Camino histórico de las mudadas estacionales. Vista espectacular sobre El Golfo desde la ermita. | El Hierro | Senderismo | Extrema</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8139" lon="-17.9147">
    <name>GR 131 El Hierro – Travesía</name>
    <desc>Travesía que cruza la isla más pequeña y sostenible de Canarias. Bosques de sabinas milenarias, volcanes y costa salvaje impresionante. | El Hierro | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7347" lon="-18.0197">
    <name>Malpaso – Cima de El Hierro</name>
    <desc>Ascenso al punto más alto de El Hierro (1.501 m). Bosques de pino canario y sabinas milenarias. Vistas a La Palma y La Gomera. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.77" lon="-18.15">
    <name>Camino de La Virgen de Los Reyes</name>
    <desc>Ruta de peregrinación histórica hasta la ermita de La Virgen de Los Reyes. Bosques de sabinas y laurisilva en entorno totalmente protegido. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.6411" lon="-17.9867">
    <name>Buceo – Reserva Marina La Restinga</name>
    <desc>Uno de los mejores spots de buceo de Europa. Aguas con 50 m de visibilidad, tortugas marinas, manta rayas y fondos volcánicos únicos. | El Hierro | Submarinismo | Fácil</desc>
    <type>Submarinismo</type>
  </wpt>
  <wpt lat="27.8025" lon="-18.0544">
    <name>Roque de La Bonanza – Frontera</name>
    <desc>Sendero por el Parque Rural de Frontera hasta el Roque de La Bonanza. Paisaje volcánico único y vistas al Mar de Las Calmas. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8322" lon="-17.9261">
    <name>Charco Manso – Costa Norte</name>
    <desc>Ruta costera hasta la piscina natural de Charco Manso en el extremo norte. Acceso por sendero entre malpaíses. Baño en aguas cristalinas. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7933" lon="-18.1375">
    <name>Sabinosa – Bosque de Sabinas Milenarias</name>
    <desc>Sendero entre sabinas milenarias retorcidas por el viento, uno de los árboles más longevos de Canarias. Paisaje mágico y único en el mundo. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.785" lon="-18.0783">
    <name>La Llanía – Sabinas Milenarias</name>
    <desc>El bosque de sabinas milenarias más impresionante de Canarias. Árboles retorcidos por el viento durante siglos. Paisaje mágico único en el Mediterráneo. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.805" lon="-18.0694">
    <name>El Golfo – Circular desde Las Puntas</name>
    <desc>Circular por el caldero volcánico de El Golfo, la bahía más hermosa de El Hierro. Vides, plataneras y el contraste entre la lava negra y el mar azul. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.65" lon="-17.975">
    <name>Punta Naos – Costa Sureste</name>
    <desc>Ruta costera por la Reserva Marina de La Restinga hasta Punta Naos. Piscinas naturales, acantilados volcánicos y la mayor concentración de estrellas de Europa. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7903" lon="-17.9503">
    <name>Tiñor – Circular por Los Alisios</name>
    <desc>Circular por el bosque de Los Alisios desde Tiñor. Laurisilva húmeda y bosque de hayas con los garoeos, árboles que capturan agua de las nubes. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8139" lon="-17.9147">
    <name>Valverde – Mirador de La Peña</name>
    <desc>Paseo desde Valverde al famoso Mirador de La Peña diseñado por César Manrique. Vistas aéreas al El Golfo y a toda la bahía desde 700 m de altura. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.84" lon="-17.91">
    <name>Roques de Salmor – Costa Norte</name>
    <desc>Ruta costera hasta los Roques de Salmor, hábitat del lagarto gigante endémico de El Hierro. Acantilados volcánicos y el mar abierto del Atlántico norte. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.72" lon="-17.98">
    <name>El Pinar – Circular por el Bosque</name>
    <desc>Circular tranquila por el Pinar de El Hierro, uno de los bosques de pino canario más densos del archipiélago. Fácil, sombreada y perfecta para familias. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.78" lon="-18.14">
    <name>Pozo de La Salud – Costa Oeste</name>
    <desc>Ruta costera hasta el famoso Pozo de La Salud con aguas mineromedicinales. Paisaje de lava negra y el horizonte abierto del Atlántico en el oeste de la isla. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.76" lon="-18.16">
    <name>Ermita de Nuestra Señora de Los Reyes</name>
    <desc>Sendero de peregrinación hasta la ermita de la patrona de El Hierro. Bosque de sabinas y el silencio absoluto del extremo occidental de España. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.71" lon="-18.14">
    <name>Faro de Orchilla – Meridiano 0</name>
    <desc>Ruta hasta el Faro de Orchilla, el punto más occidental de España. Hasta el siglo XVII fue el Meridiano 0 del mundo. Paisaje desértico y viento constante. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.8333" lon="-17.91">
    <name>Tanajara – Ruta del Lagarto Gigante</name>
    <desc>Sendero por la zona de cría del lagarto gigante de El Hierro, especie endémica recuperada del borde de la extinción. Acantilados y costa norte salvaje. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7914" lon="-18.0311">
    <name>Bajada de Jinama – El Golfo</name>
    <desc>Descenso inverso del Camino de Jinama desde Las Playas hasta El Golfo. Paisaje que cambia de costa sur árida a El Golfo verde y fértil. | El Hierro | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.6411" lon="-17.9867">
    <name>GR 131 El Hierro – Tramo Sur</name>
    <desc>Tramo sur del GR 131 desde La Restinga hasta El Pinar. Reserva Marina, bosques de pino canario y las cotas más altas del sur en un solo recorrido. | El Hierro | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.69" lon="-17.965">
    <name>Mirador de Isora – Costa Este</name>
    <desc>Ruta corta hasta el Mirador de Isora con vistas aéreas a la costa este y al Mar de Las Calmas. El agua más tranquila del archipiélago en días sin viento. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.7933" lon="-18.1167">
    <name>La Llanía – Sabinar Milenario</name>
    <desc>Paseo por el sabinar más extenso del mundo con árboles de más de 1.000 años. Las sabinas retorcidas por el viento crean paisajes únicos e irrepetibles. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.6969" lon="-18.16">
    <name>Punta Orchilla – Antiguo Meridiano 0</name>
    <desc>Sendero hasta el faro de Punta Orchilla, el punto más occidental de España. Fue el meridiano 0 del mundo durante siglos. Costa salvaje e impresionante. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.81" lon="-18.11">
    <name>Pozo de la Salud – Costa de Frontera</name>
    <desc>Ruta por la costa de El Golfo hasta el Pozo de la Salud, manantial con propiedades medicinales. Paisaje volcánico de plataformas de lava y charcos naturales. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.66" lon="-17.98">
    <name>Riscos de Herques – Costa Sur</name>
    <desc>Ruta costera por los impresionantes Riscos de Herques en el sur de El Hierro. Acantilados de más de 200 m sobre el océano y flora endémica de El Hierro. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.835" lon="-18.08">
    <name>Mirador de Bascos – El Golfo</name>
    <desc>Sendero corto hasta el mejor mirador sobre El Golfo. Vista aérea de la bahía más bonita de El Hierro con el Roque de Salmor al fondo. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.68" lon="-17.95">
    <name>El Pinar – Circular por el Bosque</name>
    <desc>Circular por el bosque de pinos centenarios de El Pinar en el sur de El Hierro. La mayor masa forestal de la isla con gran variedad de flora endémica. | El Hierro | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.65" lon="-18.01">
    <name>Playa de Tacerón – Costa Salvaje</name>
    <desc>Ruta hasta la Playa de Tacerón, una de las más aisladas de El Hierro. Arena negra volcánica y aguas cristalinas solo accesible a pie por sendero costero. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="27.71" lon="-18.04">
    <name>Ruta del Mencey – Patrimonio Bimbache</name>
    <desc>Sendero histórico por los principales yacimientos arqueológicos bimbaches. Grabados rupestres del Julan, uno de los más importantes de Canarias. | El Hierro | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2167" lon="-13.5019">
    <name>Ruta Sur – Caleta de Sebo – Montaña Amarilla</name>
    <desc>La ruta más popular de la isla. Bordea la costa sur desde Caleta de Sebo por Playa del Salado, Playa Francesa y Playa de la Cocina hasta Montaña Amarilla. Solo hay que seguir la costa. | La Graciosa | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2147" lon="-13.4808">
    <name>Montaña Amarilla – Subida a la Cima</name>
    <desc>Subida (1,8 km, dificultad alta) a la cima de Montaña Amarilla. Vistas aéreas de la Playa de la Cocina, el Atlántico y los charcos naturales para snorkel. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2592" lon="-13.5064">
    <name>Ruta Norte – Playa Las Conchas – Montaña Bermeja</name>
    <desc>La ruta más completa. Desde Caleta de Sebo por Agujas Grandes hasta Playa Las Conchas y Montaña Bermeja (157 m). Vistas a Montaña Clara y todo el Archipiélago Chinijo. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2333" lon="-13.5003">
    <name>Caleta de Sebo – Pedro Barba</name>
    <desc>Sendero costero entre los dos únicos pueblos de La Graciosa. Camino bien señalizado con postes numerados. Vistas al Risco de Famara y El Bufadero. | La Graciosa | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.24" lon="-13.475">
    <name>Ruta Este – Punta del Pobre</name>
    <desc>Travesía hasta la Punta del Pobre por la costa este. Vistas a Montaña Clara, Roque del Oeste y Alegranza. Bordea el lado oeste de Lanzarote con Famara al fondo. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.225" lon="-13.4889">
    <name>Caleta de Sebo – Barranco de los Conejos</name>
    <desc>Ruta poco conocida hacia la costa este por paisaje volcánico árido hasta una pequeña y solitaria cala. Ideal para desconectar y escapar de los senderos más transitados. | La Graciosa | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2333" lon="-13.5003">
    <name>Vuelta Integral a La Graciosa</name>
    <desc>La vuelta completa a toda la isla en un día: Majapalomas, Montaña Bermeja, Playa Las Conchas, Playa del Ámbar. Para senderistas experimentados con buen ritmo. Sin sombra ni agua. | La Graciosa | Senderismo | Difícil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2636" lon="-13.5097">
    <name>Montaña Bermeja – Cima Norte</name>
    <desc>Ascenso a la Montaña Bermeja (157 m) en el norte de la isla. Vistas espectaculares a Montaña Clara, Alegranza, Playa Las Conchas y toda La Graciosa. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2147" lon="-13.4808">
    <name>Snorkel – Charcos de Montaña Amarilla</name>
    <desc>Los charcos naturales detrás de Montaña Amarilla son los mejores de La Graciosa para snorkel. Aguas turquesas cristalinas con gran variedad de peces y fondos volcánicos. | La Graciosa | Submarinismo | Fácil</desc>
    <type>Submarinismo</type>
  </wpt>
  <wpt lat="29.2333" lon="-13.5003">
    <name>Circular Norte – Sebo, Bermeja, Conchas, Pedro Barba</name>
    <desc>Circular por el norte: Caleta de Sebo, Montaña Bermeja, Playa Las Conchas y Pedro Barba. La mejor opción para conocer la mitad norte de la isla en una jornada. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.225" lon="-13.51">
    <name>Playa Francesa – Graciosa</name>
    <desc>Sendero en bicicleta o a pie hasta la Playa Francesa, la más cercana a Caleta de Sebo. Aguas turquesas protegidas y arena dorada sin masificación turística. | La Graciosa | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.265" lon="-13.505">
    <name>Las Agujas Grandes – Norte Salvaje</name>
    <desc>Ruta hasta Las Agujas Grandes en el norte de La Graciosa. Formaciones volcánicas espectaculares y las vistas más salvajes de todo el Archipiélago Chinijo. | La Graciosa | Senderismo | Media</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.22" lon="-13.5">
    <name>Antiguas Salinas – Historia Salinera</name>
    <desc>Paseo hasta las antiguas salinas abandonadas de La Graciosa. Historia de la explotación salinera y aves zancudas que frecuentan las balsas en invierno. | La Graciosa | Fotografía | Fácil</desc>
    <type>Fotografía</type>
  </wpt>
  <wpt lat="29.23" lon="-13.485">
    <name>El Bufadero – Costa Este</name>
    <desc>Ruta costera por la costa este de La Graciosa hasta el Bufadero, formación volcánica donde el mar entra y expulsa agua con fuerza. Vistas a Lanzarote. | La Graciosa | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="29.2333" lon="-13.5003">
    <name>Vuelta en Bici a La Graciosa</name>
    <desc>La forma más popular de explorar La Graciosa. Caminos de arena y tierra entre playas, volcanes y paisajes únicos. Bicicletas de alquiler en Caleta de Sebo. | La Graciosa | Ciclismo | Media</desc>
    <type>Ciclismo</type>
  </wpt>
  <wpt lat="28.7506" lon="-13.8167">
    <name>Ruta Circular Completa – Isla de Lobos</name>
    <desc>La vuelta completa por el Parque Natural: El Puertito, La Caldera, Faro Martiño y Playa de La Concha. Requiere permiso gratuito online (máx. 200 personas/día). | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7528" lon="-13.8208">
    <name>La Caldera – Subida al Volcán</name>
    <desc>Ascenso breve al volcán de La Caldera (127 m). Vistas panorámicas a Fuerteventura, Lanzarote y el Canal de La Bocaina. El punto más alto del islote. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7489" lon="-13.8203">
    <name>Snorkel – El Puertito de Lobos</name>
    <desc>Las mejores lagunas naturales del archipiélago para snorkel. Aguas turquesas protegidas del viento con gran variedad de peces tropicales y fondos volcánicos. | Isla de Lobos | Submarinismo | Fácil</desc>
    <type>Submarinismo</type>
  </wpt>
  <wpt lat="28.7628" lon="-13.8106">
    <name>Faro de Punta Martiño</name>
    <desc>Ruta costera hasta el faro del siglo XIX en el extremo norte del islote. Entorno solitario con aves marinas, paisaje volcánico y vistas a Lanzarote. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7481" lon="-13.825">
    <name>Playa de La Concha – Lobos</name>
    <desc>La playa más tranquila del islote. Arena volcánica fina y aguas cristalinas en el interior de la bahía protegida. Ideal para el baño y el descanso. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7472" lon="-13.8186">
    <name>Antiguas Salinas de Lobos</name>
    <desc>Paseo hasta las antiguas salinas abandonadas del islote. Historia de la explotación salinera y aves zancudas que frecuentan las balsas en invierno. | Isla de Lobos | Fotografía | Fácil</desc>
    <type>Fotografía</type>
  </wpt>
  <wpt lat="28.76" lon="-13.815">
    <name>Costa Norte – Lobos</name>
    <desc>Sendero por la costa norte del islote con vistas a Lanzarote. Coladas de lava negra, pequeñas calas y la soledad de uno de los rincones más salvajes del archipiélago. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7506" lon="-13.8167">
    <name>Observación de Aves – Lobos</name>
    <desc>Isla de Lobos es hogar de pardelas, gaviotas de Audouin y otras aves marinas. Llevar prismáticos. La mejor época es primavera, en época de nidificación. | Isla de Lobos | Fotografía | Fácil</desc>
    <type>Fotografía</type>
  </wpt>
  <wpt lat="28.76" lon="-13.815">
    <name>Costa Este – Isla de Lobos</name>
    <desc>Sendero por la costa este del islote con vistas a Lanzarote. Coladas de lava negra, pequeñas calas y la soledad de uno de los rincones más salvajes del archipiélago. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7506" lon="-13.8167">
    <name>Observación de Aves – Lobos</name>
    <desc>Lobos alberga pardelas, gaviotas de Audouin y otras aves marinas protegidas. La mejor época es primavera en plena nidificación. Llevar prismáticos. | Isla de Lobos | Fotografía | Fácil</desc>
    <type>Fotografía</type>
  </wpt>
  <wpt lat="28.7628" lon="-13.8106">
    <name>Amanecer en el Faro – Lobos</name>
    <desc>Ruta nocturna para ver el amanecer desde el Faro de Punta Martiño. El cielo sin contaminación lumínica de Lobos permite ver la Vía Láctea hasta el alba. | Isla de Lobos | Fotografía | Fácil</desc>
    <type>Fotografía</type>
  </wpt>
  <wpt lat="28.7519" lon="-13.8183">
    <name>Cuevas Volcánicas – Lobos</name>
    <desc>Exploración de pequeñas cuevas y tubos volcánicos en el interior del islote. Formaciones de lava solidificada únicas con fauna rupícola protegida. | Isla de Lobos | Espeleología | Fácil</desc>
    <type>Espeleología</type>
  </wpt>
  <wpt lat="28.7506" lon="-13.8167">
    <name>Kayak – Vuelta a Isla de Lobos</name>
    <desc>Vuelta completa al islote en kayak desde Corralejo. Fondos cristalinos, cuevas marinas y la impresionante perspectiva de Lobos desde el agua. | Isla de Lobos | Kayak | Media</desc>
    <type>Kayak</type>
  </wpt>
  <wpt lat="28.7489" lon="-13.8175">
    <name>Ruta Historia – Puerto de Lobos</name>
    <desc>Paseo por el pequeño puerto y las antiguas chozas de pescadores restauradas. Historia de los lobos de mar (focas monje) que dieron nombre al islote. | Isla de Lobos | Senderismo | Fácil</desc>
    <type>Senderismo</type>
  </wpt>
  <wpt lat="28.7481" lon="-13.825">
    <name>Snorkel – Playa de La Concha</name>
    <desc>La bahía protegida de La Concha es perfecta para el snorkel con niños. Aguas poco profundas, arena blanca y gran variedad de peces en un entorno paradisíaco. | Isla de Lobos | Submarinismo | Fácil</desc>
    <type>Submarinismo</type>
  </wpt>
</gpx>